# Phantom Docker Environment Configuration
# Copy to .env and customize for your environment

# Agent Configuration
AGENT_DEBUG=false
AGENT_LOG_DIR=/app/.logs
AGENT_WATCH_DIR=/app

# OpenRouter API (required for LLM features)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/gpt-3.5-turbo

# Detection Thresholds
AGENT_THRESHOLD_PROCESS_COUNT=400
AGENT_THRESHOLD_OPEN_PORTS=100
AGENT_THRESHOLD_FILE_CHANGES=500

# PostgreSQL Configuration
POSTGRES_DB=phantom
POSTGRES_USER=phantom
POSTGRES_PASSWORD=phantom_secure_password_change_me

# Elasticsearch
ELASTIC_PASSWORD=elastic_password_change_me

# Optional Integrations
# SLACK_WEBHOOK_URL=
# TEAMS_WEBHOOK_URL=
# PAGERDUTY_KEY=